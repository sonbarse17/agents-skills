# Node/TypeScript build artifacts and dependencies. Scoped to specific paths,
# not bare "build/" or "node_modules/" - several skill categories legitimately
# have their own build/ subfolder (ci-cd/common/build, containers-orchestration/
# docker/build) and a repo-wide glob would wrongly hide that skill content.
node_modules/
mcp-server/build/
Software_Engineering_and_Other/Miscellaneous/docs-and-collab/docs-site/dist/

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp

# Reorg scratch files (this repo's skill-migration scripts write these as
# working state, always deleted before a round is reported done - ignored
# here as a backstop, not because they're expected to linger)
scripts/.*.json
scripts/.*.tsv
scripts/.*.txt
