# Node/TypeScript build artifacts and dependencies (mcp-server, docs-site, etc.
# already have their own local .gitignore for this - this is a repo-wide backstop)
node_modules/
build/
dist/

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp

# Reorg scratch files (this repo's skill-migration scripts write these as
# working state, always deleted before a round is reported done - ignored
# here as a backstop, not because they're expected to linger)
scripts/.*.json
scripts/.*.tsv
scripts/.*.txt
